{
  "$id": "http://pipewarp.dev/schemas/0.1.0-alpha.0/tool.manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PipeWarp Tool Manifest",
  "description": "A Pipewarp manifest file describing a tool.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["schemaVersion", "name", "version", "capabilities", "health"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0-alpha.0" },
    "name": { "type": "string", "minLength": 1 },

    "version": {
      "type": "string",
      "description": "The SemVer of the tool.",
      "$comment": "Should be SemVer, but not enforced"
    },

    "kind": {
      "type": "string",
      "description": "The kind of tool.",
      "enum": ["stt", "llm", "tts", "adapter", "other"],
      "default": "other"
    },

    "capabilities": {
      "type": "object",
      "description": "Capabilities of the tool.",
      "additionalProperties": false,
      "properties": {
        "mediaTypesIn": {
          "type": "array",
          "description": "List of IANA (MIME) media types the tool can accept as input.",
          "items": {
            "type": "string"
          }
        },
        "mediaTypesOut": {
          "type": "array",
          "description": "List of IANA (MIME) media types the tool can produce as output.",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxRuntimeMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },

    "health": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["endpoints"],
      "properties": {
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/HealthRedis" }
        }
      }
    }
  },

  "$defs": {
    "JsonSchema": { "type": "object" },
    "HealthRedis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key", "ttlSeconds", "heartbeatIntervalMs"],
      "properties": {
        "kind": { "const": "redis" },
        "key": {
          "type": "string",
          "description": "pw:tools:{name}:{instanceId}:hb"
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 5
        },
        "heartbeatIntervalMs": {
          "type": "integer",
          "minimum": 1000
        }
      }
    }
  }
}
