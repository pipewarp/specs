{
  "$id": "https://pipewarp.dev/schemas/0.1.0-alpha.1/flow.spec.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PipeWarp Flow",
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["schemaVersion", "id", "version", "start", "steps"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "0.1.0-alpha.1" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" },
    "start": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/Step" }
    }
  },

  "$defs": {
    "Step": {
      "type": "object",
      "unevaluatedProperties": false,
      "oneOf": [{ "$ref": "#/$defs/ToolStep" }]
    },
    "ToolStep": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["type", "mcp", "tool"],
      "properties": {
        "type": { "const": "tool" },
        "mcp": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "args": { "type": "object" },
        "save": { "type": "object" },
        "next": { "$ref": "#/$defs/NextRef" }
      }
    },
    "NextRef": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "success": { "type": "string", "minLength": 1 },
            "failure": { "type": "string", "minLength": 1 }
          },
          "minProperties": 1
        }
      ]
    }
  }
}
